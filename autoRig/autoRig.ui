  <property name="styleSheet">
   <string notr="true">/* ==========================================================================
   1. 기본 위젯 및 배경 설정 (VS Code 기본 배경색 #1E1E1E)
   ========================================================================== */
QWidget {
    background-color: #1E1E1E;
    color: #CCCCCC;
    font-family: &quot;Segoe UI&quot;, &quot;Malgun Gothic&quot;, sans-serif;
    font-size: 12px;
}

/* ==========================================================================
   2. 특정 컴포넌트 기본 스타일 (QFrame, QPlainTextEdit)
   ========================================================================== */
QFrame {
    border: none;
    background-color: #1E1E1E;
}

/* 대소문자 표기법 수정 (QplainTextEdit -&gt; QPlainTextEdit) */
QPlainTextEdit {
    background-color: #000000;
    color: #CCCCCC;
    border: 1px solid #2D2D2D;
}

/* ==========================================================================
   3. 그룹박스 (VS Code 컴포넌트 톤 #252526)
   ========================================================================== */
QGroupBox {
    background-color: #252526;         /* 기본 배경보다 살짝 밝고 푸른빛이 도는 색상 */
    border: 1px solid #323233;         /* 차분한 구분선 */
    border-radius: 6px;                /* 부드러운 라운딩 */
    margin-top: 16px;                  /* 제목이 배치될 상단 여백 */
    padding-top: 14px;                 /* 내부 콘텐츠 겹침 방지 패딩 */
    font-weight: bold;
    color: #FFFFFF;                    
}

/* 그룹박스 상단 타이틀 뱃지 스타일 */
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;     /* 좌측 상단 정렬 */
    left: 10px;                        /* 안쪽 들여쓰기 */
    padding: 2px 6px;                  /* 글자 주변 여백 */
    background-color: #007ACC;         /* VS Code 포인트 컬러 (파란색) */
    color: #FFFFFF;
    border-radius: 3px;                
    font-size: 11px;
}

/* 그룹박스 내부 위젯 기본 정렬 */
QGroupBox QWidget {
    background-color: transparent;     /* 일반 내부 위젯들은 그룹박스 배경을 이어받음 */
    color: #CCCCCC;
}

/* [★ 해결 항목] 그룹박스 내부에 들어간 QPlainTextEdit의 배경색을 검은색으로 강제 고정 */
QGroupBox QTextEdit {
    background-color: #000000;
}

/* 그룹박스 내부의 입력창 시인성 확보 */
QGroupBox QLineEdit, QGroupBox QComboBox {
    background-color: #3C3C3C;
    border: 1px solid #3C3C3C;
    color: #CCCCCC;
}
QGroupBox QLineEdit:focus {
    border: 1px solid #007ACC;
}

/* ==========================================================================
   4. 푸시 버튼 (VS Code 파란색 포인트 버튼 스타일 #0E639C)
   ========================================================================== */
QPushButton {
    background-color: #0E639C;
    color: #FFFFFF;
    border: 1px solid #114F7A;
    border-radius: 3px;
    padding: 5px 12px;
    min-height: 18px;
}
QPushButton:hover {
    background-color: #1177BB;
}
QPushButton:pressed {
    background-color: #0C5180;
}
QPushButton:disabled {
    background-color: #3C3C3C;
    color: #777777;
    border: 1px solid #303030;
}

/* 특정 중요 버튼 (빌드 버튼 등) 포인트 스타일 */
QPushButton#pushButton {
    background-color: #007ACC;
    font-weight: bold;
}
QPushButton#pushButton:hover {
    background-color: #0098FF;
}

/* ==========================================================================
   5. 콤보 박스 (드롭다운)
   ========================================================================== */
QComboBox {
    background-color: #3C3C3C;
    border: 1px solid #3C3C3C;
    border-radius: 3px;
    padding: 4px 6px;
    color: #CCCCCC;
}
QComboBox:hover {
    background-color: #4A4A4A;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left-width: 0px;
}
QComboBox QAbstractItemView {
    background-color: #2D2D2D;
    border: 1px solid #3C3C3C;
    selection-background-color: #04395E;
    selection-color: #FFFFFF;
}

/* ==========================================================================
   6. 라인 에디트 (텍스트 입력창)
   ========================================================================== */
QLineEdit {
    background-color: #3C3C3C;
    border: 1px solid #3C3C3C;
    border-radius: 3px;
    padding: 4px;
    color: #CCCCCC;
}
QLineEdit:focus {
    border: 1px solid #007ACC; /* 포커스 시 VS Code 특유의 파란 테두리 */
}

/* ==========================================================================
   7. 체크 박스
   ========================================================================== */
QCheckBox {
    spacing: 5px;
    color: #CCCCCC;
}
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    background-color: #3C3C3C;
    border: 1px solid #6B6B6B;
    border-radius: 2px;
}
QCheckBox::indicator:hover {
    background-color: #4A4A4A;
    border: 1px solid #007ACC;
}
QCheckBox::indicator:checked {
    background-color: #0E639C;
    border: 1px solid #0E639C;
}

/* ==========================================================================
   8. 탭 위젯 (VS Code 상단 에디터 탭 스타일)
   ========================================================================== */
QTabWidget::pane {
    border: 1px solid #2D2D2D;
    background-color: #1E1E1E;
}
QTabBar::tab {
    background-color: #2D2D2D;
    color: #969696;
    padding: 6px 12px;
    border-right: 1px solid #252526;
}
QTabBar::tab:selected {
    background-color: #1E1E1E;
    color: #FFFFFF;
    border-bottom: 2px solid #007ACC; /* 활성화된 탭 하단 파란 선 */
}
QTabBar::tab:hover {
    background-color: #2B2B2B;
    color: #E1E1E1;
}

/* ==========================================================================
   9. 라벨 스타일
   ========================================================================== */
QLabel {
    color: #858585; /* 항목 설명 텍스트는 차분한 회색으로 처리 */
}</string>
