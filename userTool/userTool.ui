  <property name="styleSheet">
   <string notr="true">/* =======================================================
   VS Code Dark Theme for Qt Designer
======================================================= */

/* 1. 기본 창 및 전체 위젯 배경 설정 */
QWidget {
    background-color: #1e1e1e; /* VSC 메인 배경색 */
    color: #d4d4d4;            /* VSC 기본 텍스트 색상 */
    font-family: &quot;Segoe UI&quot;, &quot;Malgun Gothic&quot;, sans-serif;
    font-size: 9pt;
}

/* 2. 그룹박스 (QGroupBox) */
QGroupBox {
    border: 1px solid #3e3e42;
    border-radius: 4px;
    margin-top: 15px;
    padding-top: 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    color: #569cd6; /* VSC 파란색 키워드 포인트 */
    font-weight: bold;
}

/* 3. 탭 위젯 (QTabWidget &amp; QTabBar) */
QTabWidget::pane {
    border: 1px solid #3e3e42;
    background-color: #1e1e1e;
}
QTabBar::tab {
    background-color: #2d2d30; /* 비활성 탭 배경 */
    color: #969696;
    padding: 6px 15px;
    border-right: 1px solid #1e1e1e;
    border-top: 2px solid transparent;
}
QTabBar::tab:selected {
    background-color: #1e1e1e; /* 활성 탭 배경 */
    color: #ffffff;
    border-top: 2px solid #007acc; /* VSC 활성 탭 파란색 줄 */
}
QTabBar::tab:hover:!selected {
    background-color: #252526;
    color: #d4d4d4;
}

/* 4. 일반 버튼 (QPushButton) 
   (아래에 선언된 #ID 색상 버튼들을 제외한 나머지 버튼에 적용됨) */
QPushButton {
    background-color: #3c3c3c;
    color: #cccccc;
    border: 1px solid #3c3c3c;
    padding: 5px 12px;
    border-radius: 3px;
}
QPushButton:hover {
    background-color: #464646;
    border: 1px solid #5a5a5a;
}
QPushButton:pressed {
    background-color: #007acc; /* 클릭 시 파란색 포인트 */
    color: #ffffff;
    border: 1px solid #007acc;
}

/* 5. 입력창, 콤보박스, 스핀박스 */
QLineEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #3c3c3c;
    color: #d4d4d4;
    border: 1px solid #3c3c3c;
    padding: 3px 5px;
    border-radius: 2px;
}
QLineEdit:focus, QTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #007fd4; /* 입력 활성화(포커스) 시 테두리 하이라이트 */
}
QComboBox QAbstractItemView {
    background-color: #252526;
    color: #d4d4d4;
    border: 1px solid #3e3e42;
    selection-background-color: #062f4a; /* 드롭다운 목록 선택 시 배경색 */
}

/* 6. 체크박스 및 라디오버튼 */
QCheckBox, QRadioButton {
    color: #d4d4d4;
    spacing: 5px;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
    background-color: #3c3c3c;
    border: 1px solid #5a5a5a;
    border-radius: 2px;
}
QRadioButton::indicator {
    border-radius: 7px; /* 원형 */
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border: 1px solid #007fd4;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #007acc;
    border: 1px solid #007acc;
}

/* 7. 스크롤바 (QScrollBar) */
QScrollBar:vertical {
    background-color: #1e1e1e;
    width: 12px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background-color: #424242;
    min-height: 20px;
    border-radius: 5px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover {
    background-color: #4f4f4f;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px; /* VSC 스타일처럼 스크롤바 위아래 화살표 숨김 */
}

#curvePreviw_Le {qproperty-alignment: 'AlignHCenter | AlignVCenter';}


/* =======================================================
   8. User Defined Color Buttons (색상 버튼들 제외 규칙)
======================================================= */
/* 특정 ID(#)가 부여된 스타일은 일반 클래스(QPushButton)보다 명시도(우선순위)가 
   높기 때문에, 위에서 설정한 회색 버튼 스타일을 덮어쓰고 고유 색상이 유지됩니다. */

#boulderColor_Btn { background-color: #787878; border: 1px solid #2d2d30; }
#blackColor_Btn { background-color: #000000; border: 1px solid #2d2d30; }
#silverColor_Btn { background-color: #BFBFBF; border: 1px solid #2d2d30; }
#grayColor_Btn { background-color: #808080; border: 1px solid #2d2d30; }
#monzaColor_Btn { background-color: #CC0033; border: 1px solid #2d2d30; }
#stratosColor_Btn { background-color: #000460; border: 1px solid #2d2d30; }
#blueColor_Btn { background-color: #0000FF; border: 1px solid #2d2d30; }
#crusoeColor_Btn { background-color: #004619; border: 1px solid #2d2d30; }
#tolopeaColor_Btn { background-color: #260043; border: 1px solid #2d2d30; }
#purplePizzazzColor_Btn { background-color: #C800C8; border: 1px solid #2d2d30; }
#muleFawnColor_Btn { background-color: #8A4833; border: 1px solid #2d2d30; }
#jonColor_Btn { background-color: #3F231F; border: 1px solid #2d2d30; }
#totemPoleColor_Btn { background-color: #992600; border: 1px solid #2d2d30; }
#redColor_Btn { background-color: #FF0000; border: 1px solid #2d2d30; }
#greenColor_Btn { background-color: #00FF00; border: 1px solid #2d2d30; }
#smaltColor_Btn { background-color: #004199; border: 1px solid #2d2d30; }
#whiteColor_Btn { background-color: #FFFFFF; border: 1px solid #2d2d30; }
#yellowColor_Btn { background-color: #FFFF00; border: 1px solid #2d2d30; }
#skyColor_Btn { background-color: #64DCFF; border: 1px solid #2d2d30; }
#screaminGreenColor_Btn { background-color: #43FFA3; border: 1px solid #2d2d30; }
#sundownColor_Btn { background-color: #FFB0B0; border: 1px solid #2d2d30; }
#harvestGoldColor_Btn { background-color: #E4AC79; border: 1px solid #2d2d30; }
#laserLemonColor_Btn { background-color: #FFFF63; border: 1px solid #2d2d30; }
#greenHazeColor_Btn { background-color: #009954; border: 1px solid #2d2d30; }
#copperColor_Btn { background-color: #A16A30; border: 1px solid #2d2d30; }
#yellowGreenColor_Btn { background-color: #9EA130; border: 1px solid #2d2d30; }
#sushiColor_Btn { background-color: #68A130; border: 1px solid #2d2d30; }
#seaGreenColor_Btn { background-color: #30A15D; border: 1px solid #2d2d30; }
#keppelColor_Btn { background-color: #30A1A1; border: 1px solid #2d2d30; }
#azureColor_Btn { background-color: #3067A1; border: 1px solid #2d2d30; }
#royalPurpleColor_Btn { background-color: #6F30A1; border: 1px solid #2d2d30; }
#royalHeathColor_Btn { background-color: #A1306A; border: 1px solid #2d2d30; }

/* =======================================================
   9. Disabled (비활성화 / Lock 상태) 스타일
======================================================= */

/* 전체 위젯의 비활성화 텍스트 색상 저하 */
*:disabled {
    color: #555555;
}

/* 비활성화된 일반 버튼 */
QPushButton:disabled {
    background-color: #252526; /* 활성 버튼(#3c3c3c)보다 더 어둡고 배경에 가깝게 */
    border: 1px solid #2d2d30;
    color: #555555;
}

/* 비활성화된 입력창 및 콤보박스 */
QLineEdit:disabled, QTextEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    background-color: #1e1e1e; /* 메인 배경과 동일하게 만들어 '닫힌' 느낌 부여 */
    border: 1px dotted #3e3e42; /* 점선으로 잠김(Lock) 상태 강조 */
    color: #555555;
}

/* 비활성화된 체크박스 및 라디오버튼 네모/동그라미 */
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background-color: #252526;
    border: 1px solid #3e3e42;
}
QCheckBox::indicator:checked:disabled, QRadioButton::indicator:checked:disabled {
    background-color: #062f4a; /* 파란색(#007acc)의 채도를 확 낮춘 탁한 파란색 */
    border: 1px solid #062f4a;
}

/* =======================================================
   10. User Defined Color Buttons (비활성화 오버라이드)
======================================================= */
/* ID(#) 선택자는 명시도(우선순위)가 매우 높기 때문에, 
   일반 QPushButton:disabled 만으로는 색상이 지워지지 않습니다. 
   아래처럼 ID 뒤에 :disabled를 붙여서 고유 색상을 회색으로 덮어씌워야 합니다. */

#boulderColor_Btn:disabled, #blackColor_Btn:disabled, #silverColor_Btn:disabled, 
#grayColor_Btn:disabled, #monzaColor_Btn:disabled, #stratosColor_Btn:disabled, 
#blueColor_Btn:disabled, #crusoeColor_Btn:disabled, #tolopeaColor_Btn:disabled, 
#purplePizzazzColor_Btn:disabled, #muleFawnColor_Btn:disabled, #jonColor_Btn:disabled, 
#totemPoleColor_Btn:disabled, #redColor_Btn:disabled, #greenColor_Btn:disabled, 
#smaltColor_Btn:disabled, #whiteColor_Btn:disabled, #yellowColor_Btn:disabled, 
#skyColor_Btn:disabled, #screaminGreenColor_Btn:disabled, #sundownColor_Btn:disabled, 
#harvestGoldColor_Btn:disabled, #laserLemonColor_Btn:disabled, #greenHazeColor_Btn:disabled, 
#copperColor_Btn:disabled, #yellowGreenColor_Btn:disabled, #sushiColor_Btn:disabled, 
#seaGreenColor_Btn:disabled, #keppelColor_Btn:disabled, #azureColor_Btn:disabled, 
#royalPurpleColor_Btn:disabled, #royalHeathColor_Btn:disabled {
    background-color: #2d2d30;
    border: 1px solid #1e1e1e;
}
</string>
