  <property name="styleSheet">
   <string notr="true">/* ==========================================================
   Resize Image Manager  —  Dark Theme (VSCode-inspired)
   ========================================================== */

/* ---- Base ------------------------------------------------ */
QWidget {
    background-color: #1E1E1E;
    color: #D4D4D4;
    font-size: 10pt;
    font-family: &quot;Segoe UI&quot;, &quot;Pretendard&quot;, sans-serif;
}

/* ---- Frame / Panel --------------------------------------- */
QFrame {
    background-color: #252526; /* 베이스 패널 색상 */
    border: none;
    border-radius: 5px;
}

/* ---- GroupBox (영역 구분이 확실해지도록 수정) ---------------- */
QGroupBox {
    background-color: #2A2A2B; /* 베이스 패널보다 살짝 밝게 띄움 */
    border: 1px solid #4D4D50; /* 테두리를 주어 영역을 확실히 분리 */
    border-radius: 6px;
    margin-top: 14px;
    padding: 10px 6px 6px 6px;
    font-weight: bold;
    color: #9CDCFE;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 6px;
    background-color: #2A2A2B; /* 타이틀 배경도 동일하게 맞춤 */
    color: #9CDCFE;
}

/* ---- Label ----------------------------------------------- */
QLabel {
    background-color: transparent;
    border: none;
    color: #CCCCCC;
}

/* ---- LineEdit / TextEdit --------------------------------- */
QLineEdit, QPlainTextEdit, QTextEdit {
    background-color: #181818;
    border: 1px solid #3C3C3C;
    border-radius: 4px;
    padding: 5px;
    color: #D4D4D4;
    selection-background-color: #007ACC;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus {
    border: 1px solid #007ACC;
}

QLineEdit:disabled, QPlainTextEdit:disabled {
    background-color: #1A1A1A;
    color: #5A5A5A;
    border: 1px solid #2A2A2A;
}

/* ---- Button ---------------------------------------------- */
QPushButton {
    background-color: #007ACC;
    color: #FFFFFF;
    border: 1px solid #1C97EA;
    border-radius: 4px;
    padding: 6px 12px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #1F8AD2;
    border: 1px solid #3AB0FF;
}

QPushButton:pressed {
    background-color: #005C99;
}

QPushButton:disabled {
    background-color: #2A2A2A;
    color: #5A5A5A;
    border: 1px solid #3C3C3C;
}

/* primary action button — 실행 버튼 */
QPushButton#build_Btn {
    background-color: #2EA043;
    border: 1px solid #3FB950;
    font-size: 11pt;
    font-weight: bold;
    padding: 10px 16px;
}

QPushButton#build_Btn:hover {
    background-color: #3FB950;
    border: 1px solid #56D364;
}

QPushButton#build_Btn:pressed {
    background-color: #238636;
}

/* tool / icon-only button — 아이콘 버튼들 */
QPushButton#info_Btn,
QPushButton#reload_organizeData_Btn,
QPushButton#clean_organizeData_Btn,
QPushButton#setFolderPath_Btn,
QPushButton#openLogPte_Btn,
QPushButton#clearLogPte_Btn {
    background-color: #4D4D50; 
    border: 1px solid #5A5A5C;
    color: #FFFFFF;
    padding: 4px 8px;
    min-width: 24px;
}

QPushButton#info_Btn:hover,
QPushButton#reload_organizeData_Btn:hover,
QPushButton#clean_organizeData_Btn:hover,
QPushButton#setFolderPath_Btn:hover,
QPushButton#openLogPte_Btn:hover,
QPushButton#clearLogPte_Btn:hover {
    background-color: #626266;
    border: 1px solid #7B7B7F;
}

/* ---- SpinBox --------------------------------------------- */
QSpinBox {
    background-color: #181818;
    border: 1px solid #3C3C3C;
    border-radius: 4px;
    padding: 3px 6px;
    color: #D4D4D4;
    selection-background-color: #007ACC;
}

QSpinBox:focus {
    border: 1px solid #007ACC;
}

QSpinBox:disabled {
    background-color: #1A1A1A;
    color: #5A5A5A;
}

QSpinBox::up-button {
    background-color: #3C3C3C;
    border: none;
    border-top-right-radius: 3px;
    width: 16px;
}

QSpinBox::down-button {
    background-color: #3C3C3C;
    border: none;
    border-bottom-right-radius: 3px;
    width: 16px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #4D4D50;
}

QSpinBox::up-arrow {
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #FFFFFF;
    width: 0;
    height: 0;
}

QSpinBox::down-arrow {
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #FFFFFF;
    width: 0;
    height: 0;
}

/* ---- ListWidget ------------------------------------------ */
QListWidget {
    background-color: #181818;
    border: 1px solid #3C3C3C;
    border-radius: 4px;
    padding: 4px;
    color: #D4D4D4;
    outline: none;
}

QListWidget::item {
    background-color: #252526;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px;
    margin: 2px;
    color: #CCCCCC;
}

QListWidget::item:hover {
    background-color: #2D2D30;
    border: 1px solid #4D4D50;
}

QListWidget::item:selected {
    background-color: #007ACC;
    border: 1px solid #1C97EA;
    color: #FFFFFF;
}

/* ---- TableWidget ----------------------------------------- */
QTableWidget {
    background-color: #181818;
    border: 1px solid #3C3C3C;
    border-radius: 4px;
    color: #D4D4D4;
    gridline-color: #4D4D50;
    outline: none;
}

QTableWidget::item {
    padding: 4px;
    border-bottom: 1px solid #2D2D30;
}

QTableWidget::item:selected {
    background-color: #007ACC;
    color: #FFFFFF;
}

QHeaderView::section {
    background-color: #2D2D30;
    color: #9CDCFE;
    padding: 4px;
    border: 1px solid #3C3C3C;
    border-top: none;
    border-left: none;
    font-weight: bold;
}

QTableCornerButton::section {
    background-color: #2D2D30;
    border: 1px solid #3C3C3C;
}

/* ---- ProgressBar ----------------------------------------- */
QProgressBar {
    background-color: #181818;
    border: 1px solid #3C3C3C;
    border-radius: 4px;
    text-align: center;
    color: #FFFFFF;
    font-weight: bold;
    min-height: 18px;
}

QProgressBar::chunk {
    background-color: #007ACC;
    border-radius: 3px;
}

/* ---- ScrollBar ------------------------------------------- */
QScrollBar:vertical {
    background-color: #1E1E1E;
    width: 12px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #4D4D50;
    border-radius: 5px;
    min-height: 30px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #626266;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: #1E1E1E;
    height: 12px;
    margin: 0;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #4D4D50;
    border-radius: 5px;
    min-width: 30px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #626266;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}</string>
